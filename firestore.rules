rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read all spaces
    match /spaces/{spaceId} {
      allow read: if true;
      allow write: if true; // Temporarily allow anyone to write to spaces
    }
    
    // User profile and credits
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Unlocked status
    match /unlocks/{unlockId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid == unlockId.split('_')[0]);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
